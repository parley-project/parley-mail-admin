<?xml version="1.0" encoding="UTF-8"?>
<!-- The admin's own logging configuration (Log4j). Parley code logs through BaseObject to System.Logger, which
     log4j-jpl hands to Log4j, so these loggers, appenders and levels are all there is to set.
     The Logs page shows what the LogPage appender gets and sets the levels of the sources named here.
     Use another file with -Dlog4j2.configurationFile=... -->
<Configuration status="warn" name="parley-mail-admin">
	<Appenders>
		<Console name="Console" target="SYSTEM_ERR">
			<PatternLayout pattern="%d{ISO8601} [%t] %-5level %logger{1.} - %msg%n"/>
		</Console>
		<LogPage name="LogPage"/>
	</Appenders>
	<Loggers>
		<Logger name="us.bringardner" level="info"/>
		<Root level="warn">
			<AppenderRef ref="Console"/>
			<AppenderRef ref="LogPage"/>
		</Root>
	</Loggers>
</Configuration>
