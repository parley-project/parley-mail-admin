# Parley mail suite settings shared by every mail server, made by parley-mail-admin on its first start.
# The SMTP, IMAP and POP3 servers read this file, then their own (parley-smtp.properties,
# parley-imap.properties, parley-pop3.properties in the same folder), whether they run in the admin
# application or as services (parley-net's launcher). Edit them on the Settings page (or here, then
# restart the services); any setting of the parley-smtp, parley-imap and parley-pop3 READMEs can be
# used. The ports below are high ports so the suite runs without root while you try it out; use 25,
# 587, 465, 143, 993, 110 and 995 on a real server. A port of 0 turns that service off.

# ---------------------------------------------------------------- store, users, TLS

# Where the mail lives: one directory per user, the SMTP queue (.smtp-queue) and DMARC report data
parley.mail.root=@HOME@/mail

# Users (name , password-hash , READ|WRITE|ADMIN , maildrop=...); managed on the Users page
parley.mail.users=@HOME@/users.txt

# TLS key store used by every service that has no key store of its own
#parley.mail.tls.keyStore=@HOME@/tls/keystore.p12
#parley.mail.tls.keyStorePassword=
#parley.mail.tls.keyStoreType=PKCS12

# ---------------------------------------------------------------- services and ports

# The services that run (the Dashboard's Turn on and Turn off change this list). The implicit TLS
# ones (submissions, imaps, pop3s, ftps) need a key store: until there is one they are skipped.
parley.servers=smtp,submission,submissions,imap,imaps,pop3,pop3s,ftp,ftps

parley.mail.smtp.port=2525
parley.mail.submission.port=2587
parley.mail.submissions.port=2465
parley.mail.imap.port=2143
parley.mail.imaps.port=2993
parley.mail.pop3.port=2110
parley.mail.pop3s.port=2995
# FTP for the mail users (name@domain): refuses logins before AUTH TLS, so it needs a key store
parley.mail.ftp.port=2121
parley.mail.ftps.port=2990

# ---------------------------------------------------------------- SMTP

# The host name (each SMTP server's and the queue's) has no default: set it on Settings > SMTP. The
# local domains, the aliases file and how mail is delivered are the queue's own settings
# (<mail root>/.smtp-queue/queue.properties: Settings > Queue, the Domains and Aliases pages), and the
# store's sharing is the store's (<mail root>/.parley-store.properties: Settings > Store).

# Clients that may relay without logging in
parley.mail.smtp.relayNetworks=127.0.0.1/32

# ---------------------------------------------------------------- the admin application

# Where the servers run: empty runs them in the web application; JMX service URLs of launcher
# processes run as services (comma separated) manage those instead
#parley.mail.admin.jmxUrl=service:jmx:rmi:///jndi/rmi://localhost:9010/jmxrmi

# Start the enabled services when the web application starts (when they run in it)
parley.mail.admin.autoStart=true
